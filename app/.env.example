# LUNA-MATCH AI Layer Configuration

# VLM Configuration
VLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
# Backend options: "openai" (for vLLM/OpenAI-compatible APIs), "transformers" (for local GPU/MPS), "mock" (for offline/tests)
VLM_BACKEND=openai
VLM_BASE_URL=https://api.openai.com/v1
VLM_API_KEY=your_api_key_here
VLM_MAX_TOKENS=1024
VLM_TEMPERATURE=0.2

# RAG Configuration
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_INDEX_PATH=data/index
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.3
KNOWLEDGE_DIR=knowledge

# Core ML Engine API Configuration
CORE_ML_API_URL=http://localhost:8001
CORE_ML_USE_MOCK=true
CORE_ML_TIMEOUT_SECONDS=60

# Fast API / Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true
