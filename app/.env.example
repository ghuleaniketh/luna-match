# LUNA-MATCH AI Layer - Environment Configuration
# Copy this file to .env and fill in your values.

# ─── VLM Backend ─────────────────────────────────────────────────────────────
VLM_MODEL=Qwen/Qwen3-VL-8B-Instruct

# VLM_BACKEND options:
#   "transformers" → local Qwen3-VL-8B-Instruct via HuggingFace (requires GPU + ~16 GB RAM)
#   "openai"       → OpenAI-compatible API (OpenAI, OpenRouter, vLLM, self-hosted)
#   "groq"         → Groq-hosted multimodal model (recommended for image-aware demo + no local GPU)
#   "mock"         → deterministic offline mock (no GPU required, great for demos)
# For Groq vision use:
#   VLM_BACKEND=groq
#   GROQ_API_KEY=your_groq_api_key_here
#   GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
VLM_BACKEND=mock

# ─── Option A: Local Transformers (Qwen3-VL-8B-Instruct) ─────────────────────
# Set VLM_BACKEND=transformers and run:
#   pip install git+https://github.com/huggingface/transformers
#   pip install accelerate qwen-vl-utils torch torchvision
# Model weights downloaded automatically from HuggingFace Hub (~16 GB, first run only).

# ─── Option B: OpenAI-Compatible API (vLLM self-hosted) ──────────────────────
# Start vLLM server:
#   vllm serve Qwen/Qwen3-VL-8B-Instruct --host 0.0.0.0 --port 8001 --dtype auto
# Then set:
VLM_BASE_URL=http://localhost:8001/v1
VLM_API_KEY=dummy-key-for-local-vllm

# ─── Option C: Groq-hosted VLM (no local model download) ────────────────────
# Recommended default multimodal Groq model for image-aware VLM use:
#   meta-llama/llama-4-scout-17b-16e-instruct
# Set VLM_BACKEND=groq and provide a key from https://console.groq.com/keys
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ─── VLM Generation Hyperparameters (Qwen3-VL VL recommended defaults) ───────
VLM_MAX_TOKENS=2048
VLM_TEMPERATURE=0.7
VLM_TOP_P=0.8
VLM_TOP_K=20
VLM_REPETITION_PENALTY=1.0

# ─── RAG Configuration ────────────────────────────────────────────────────────
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_INDEX_PATH=data/index
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.3
KNOWLEDGE_DIR=knowledge
RAG_DATA_DIR=data

# ─── Core ML Engine API ───────────────────────────────────────────────────────
CORE_ML_API_URL=http://localhost:8001
CORE_ML_USE_MOCK=true
CORE_ML_TIMEOUT_SECONDS=60

# ─── FastAPI Server ───────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true
